function main() {
    /// @process サーバにデータ送信
    sendData("Hello, server!");
}

function sendData(data: string) {
    /// @process 送信データをシリアライズ
    let raw_data: string = "Hello, server!";
    let serialized_data: string = serializeData(raw_data);

    /// @process サーバと接続確立
    let is_connented: bool = tryConnection();
    if (is_connented) {
        /// @process データ送信
        transmitData(serialized_data);
    }
}

function serializeData(raw_data: string) -> string {
    /// @process データをシリアライズ
    return raw_data;
}

function tryConnection() -> bool {
    /// @process サーバと接続試行
    return true;
}

function transmitData(data: string) {
    /// @process データを送信
    print("データ送信完了:");
    print(data);
}
 